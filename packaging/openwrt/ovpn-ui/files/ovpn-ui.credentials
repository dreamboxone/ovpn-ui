#!/bin/sh
# /usr/lib/ovpn-ui/credentials.sh — generate the panel's first login once.
#
# The file is only a seed: the init script writes it into the database on the first
# start, and after that the database is the truth (change it with `ovpn-ui --pass`).
# It stays readable by root alone, next to the database.

. /usr/lib/ovpn-ui/env.sh
ovpn_ui_load_env

creds="$VPNUI_DB_FOLDER/initial-credentials"
[ -s "$creds" ] && exit 0

rand() {
	tr -dc "$1" </dev/urandom 2>/dev/null | head -c "$2"
}

mkdir -p "$VPNUI_DB_FOLDER"
chmod 0700 "$VPNUI_DB_FOLDER"

lan_ip="$(uci -q get network.lan.ipaddr)"
lan_ip="${lan_ip%%/*}"
[ -n "$lan_ip" ] || lan_ip="192.168.1.1"

user="admin$(rand '0-9' 4)"
pass="$(rand 'A-Za-z0-9' 20)"
path="$(rand 'a-z0-9' 12)"
# 2053 unless something already listens there (uhttpd, another panel...).
port=2053
while netstat -ltn 2>/dev/null | grep -q "[:.]$port[[:space:]]"; do
	port=$((port + 1))
done

umask 077
cat > "$creds" <<EOF
username=$user
password=$pass
port=$port
path=$path
url=http://$lan_ip:$port/$path/
EOF
