#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

BIN=/usr/lib/ovpn-ui/ovpn-ui

# Seed the database on the very first start with the credentials uci-defaults
# generated, so the panel never comes up with a default admin/admin login.
first_run() {
	local db="$VPNUI_DB_FOLDER/vpn-ui.db"
	local creds="$VPNUI_DB_FOLDER/initial-credentials"
	[ -s "$db" ] && return 0

	[ -s "$creds" ] || /usr/lib/ovpn-ui/credentials.sh
	[ -s "$creds" ] || { logger -t ovpn-ui "missing $creds, cannot initialise the panel"; return 1; }

	local user pass port path
	user="$(sed -n 's/^username=//p' "$creds")"
	pass="$(sed -n 's/^password=//p' "$creds")"
	port="$(sed -n 's/^port=//p' "$creds")"
	path="$(sed -n 's/^path=//p' "$creds")"

	logger -t ovpn-ui "initialising the panel database in $VPNUI_DB_FOLDER"
	( umask 077; "$BIN" --user "$user" --pass "$pass" --port "$port" --path "$path" >/dev/null 2>&1 )
}

start_service() {
	. /usr/lib/ovpn-ui/env.sh
	ovpn_ui_load_env

	[ "$OVPNUI_ENABLED" = 1 ] || return 0

	mkdir -p "$VPNUI_DB_FOLDER" "$VPNUI_BIN_FOLDER" "$VPNUI_LOG_FOLDER"
	chmod 0700 "$VPNUI_DB_FOLDER"

	first_run || return 1

	procd_open_instance
	procd_set_param command "$BIN" run
	procd_set_param env \
		VPNUI_DB_FOLDER="$VPNUI_DB_FOLDER" \
		VPNUI_BIN_FOLDER="$VPNUI_BIN_FOLDER" \
		XRAY_LOCATION_ASSET="$XRAY_LOCATION_ASSET" \
		VPNUI_LOG_FOLDER="$VPNUI_LOG_FOLDER" \
		VPNUI_LOG_LEVEL="$VPNUI_LOG_LEVEL" \
		GOMEMLIMIT="$GOMEMLIMIT" \
		NO_COLOR=1 \
		HOME=/root
	procd_set_param limits nofile="65535 65535"
	procd_set_param respawn 3600 10 5
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/ovpn-ui.pid
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "ovpn-ui"
}

reload_service() {
	restart
}
