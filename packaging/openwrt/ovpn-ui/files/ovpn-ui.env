# Shared by /etc/init.d/ovpn-ui and /usr/bin/ovpn-ui: turns the UCI config into the
# environment the panel reads. Without it the panel would put its database next to
# the binary (/usr/lib/ovpn-ui), which is not what the service uses.

. /lib/functions.sh

ovpn_ui_load_env() {
	config_load ovpn-ui
	config_get OVPNUI_ENABLED   main enabled   1
	config_get OVPNUI_DATA_DIR  main data_dir  /etc/ovpn-ui
	config_get OVPNUI_BIN_DIR   main bin_dir   /usr/lib/ovpn-ui/bin
	config_get OVPNUI_LOG_DIR   main log_dir   /var/log/ovpn-ui
	config_get OVPNUI_LOG_LEVEL main log_level warning
	config_get OVPNUI_MEM_LIMIT main mem_limit 160MiB

	export VPNUI_DB_FOLDER="$OVPNUI_DATA_DIR"
	export VPNUI_BIN_FOLDER="$OVPNUI_BIN_DIR"
	# Xray inherits the panel's environment; point it at the geo files explicitly.
	export XRAY_LOCATION_ASSET="$OVPNUI_BIN_DIR"
	export VPNUI_LOG_FOLDER="$OVPNUI_LOG_DIR"
	export VPNUI_LOG_LEVEL="$OVPNUI_LOG_LEVEL"
	export GOMEMLIMIT="$OVPNUI_MEM_LIMIT"
}
