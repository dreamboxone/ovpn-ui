
config ovpn-ui 'main'
	# 0 keeps the service from starting at boot (and from starting at all).
	option enabled '1'
	# Database, certificates and the first-boot credentials. Kept across sysupgrade.
	option data_dir '/etc/ovpn-ui'
	# The Xray core and geo files the panel unpacks on every start (~60 MB).
	option bin_dir '/usr/lib/ovpn-ui/bin'
	option log_dir '/var/log/ovpn-ui'
	# debug | info | notice | warning | error
	option log_level 'warning'
	# Soft Go heap limit, so the panel returns memory before the router runs short.
	option mem_limit '160MiB'
